{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "test:e2e": "npm run build && playwright test",
        "contract:build": "tsp compile contract --config contract/tspconfig.yaml",
        "contract:sdk": "openapi-ts -f contract/openapi-ts.config.ts",
        "contract:generate": "npm run contract:build && npm run contract:sdk",
        "contract:check": "npm run contract:generate && git diff --exit-code -- contract resources/js/api && test -z \"$(git ls-files --others --exclude-standard -- contract resources/js/api)\""
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-query": "^5.105.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "@typespec/compiler": "~1.17.0",
        "@typespec/http": "~1.17.0",
        "@typespec/json-schema": "~1.17.0",
        "@typespec/openapi": "~1.17.0",
        "@typespec/openapi3": "~1.17.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "vite-plus": "1.4.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "engines": {
        "node": ">=22"
    }
}
