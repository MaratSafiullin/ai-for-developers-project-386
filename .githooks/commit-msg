#!/usr/bin/env bash
#
# Checks the first line of a commit message against Conventional Commits.
# Keep the list of types in sync with .ai/guidelines/conventional-commits.md.

set -euo pipefail

# Git runs this hook before stripping comments and blank lines, so skip them here.
subject="$(grep -v -m 1 -E '^[[:space:]]*(#|$)' "$1" || true)"
subject="${subject%$'\r'}"
subject="${subject%"${subject##*[![:space:]]}"}"

if [[ "$subject" =~ ^(Merge\ |Revert\ \"|fixup!\ |squash!\ |amend!\ ) ]]; then
    exit 0
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\([[:lower:][:digit:]._/-]+\))?!?: [[:lower:][:digit:]](.*[^.])?$"

if [[ "$subject" =~ $pattern ]]; then
    exit 0
fi

cat >&2 <<EOF
Commit message does not follow Conventional Commits:

    $subject

Expected: <type>[optional scope][!]: <description>
Types: ${types//|/, }
The description starts with a lowercase letter and has no trailing period.
Example: feat(api): return 404 for missing slot

See .ai/guidelines/conventional-commits.md
EOF

exit 1
