{
    "permissions": {
        "allow": [
            "WebFetch(domain:laravel.com)",
            "WebFetch(domain:inertiajs.com)",
            "WebFetch(domain:pestphp.com)"
        ],
        "deny": [
            "Edit(./.githooks/**)",
            "Edit(./.junie/**)",
            "Edit(./vendor/**)",
            "Edit(./node_modules/typescript/**)",
            "Edit(./node_modules/.bin/**)",
            "Read(./.env)",
            "Read(./.env.backup)",
            "Read(./.env.production)",
            "Read(./.env.local)",
            "Read(./.env.testing)",
            "Read(./auth.json)",
            "Read(./storage/*.key)"
        ]
    }
}
